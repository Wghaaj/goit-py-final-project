Screen {
    background: #101217;
    color: #e2e8f0;
}

/* Header */

#app-header {
    height: auto;
    background: #1e222c;
    padding: 1 2;
    margin-bottom: 1;
    align: center middle;
}

#app-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: #facc15;
}

#app-subtitle {
    width: 100%;
    text-align: center;
    color: #94a3b8;
}



/* Navigation */

TabbedContent {
    height: 1fr;
    margin: 0 2;
}

Tab {
    height: 3;
    padding: 0 3;
    color: #94a3b8;
    background: #1e222c;
    border: round #facc15;
    content-align: center middle;
}

Tabs {
    height: 4;
}

Tab.-active {
    background: #facc15;
    color: #101217;
    text-style: bold;
}

TabPane {
    height: 1fr;
    width: 100%;
    padding: 1 2;
    overflow-y: auto;
}

Underline {
    visibility: hidden;
}

/* Tables */

DataTable {
    height: 1fr;
    background: #1e222c;
    border: round #343945;
}

DataTable .datatable--header {
    background: #2b303d;
    color: #facc15;
    text-style: bold;
}

DataTable .datatable--cursor {
    background: #facc15;
    color: #101217;
}

/* Buttons */

Button {
    border: round #343945;
    background: #1e222c;
    color: #facc15;
}

Button:hover {
    border: round #facc15;
}

/* Navigation */

Tab {
    width: 20;
    height: 3;
    margin-right: 1;
    content-align: center middle;
}

/* Page content */

.page-title {
    color: #facc15;
    text-style: bold;
    margin-bottom: 1;
}


/* Command input */

#command {
    background: #1e222c;
    border: solid #facc15;
    margin: 1 2;
    padding: 0 1;
}

/* Command output */

#command-output {
    height: 8;
    background: #1e222c;
    border: round #343945;
    margin: 0 2;
    padding: 1 2;
    color: #e2e8f0;
}

#command:focus {
    border: solid #fde047;
}

/* Footer */

Footer {
    background: #1e222c;
    color: #94a3b8;
}